FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PROGRAM_OS_ENABLE_LIVE_AGENT=false \
    PROGRAM_OS_AUDIT_PATH=/tmp/program-os/audit.jsonl

WORKDIR /app

COPY pyproject.toml requirements.lock README.md LICENSE ./
COPY src ./src
COPY examples ./examples

RUN python -m pip install --no-cache-dir -r requirements.lock \
    && python -m pip install --no-cache-dir --no-deps . \
    && groupadd --system programos \
    && useradd --system --gid programos --home-dir /app --shell /usr/sbin/nologin programos \
    && mkdir -p /var/program-os \
    && chown -R programos:programos /var/program-os /app

USER programos

EXPOSE 8000

CMD ["uvicorn", "program_os.api:app", "--host", "0.0.0.0", "--port", "8000"]
